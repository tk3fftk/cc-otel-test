# Grafana Cloud の OTLP gateway URL (リージョンにより異なる)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-northeast-0.grafana.net/otlp

# Grafana Cloud の Stack ID (Connections > OpenTelemetry の案内に表示される数値)
GRAFANA_CLOUD_INSTANCE_ID=replace-me

# Grafana Cloud Access Policy で発行した API トークン
GRAFANA_CLOUD_API_KEY=replace-me

# Collector 自身のテレメトリ送信用に事前計算する Basic 認証ヘッダ
# 生成例:
#   echo -n "Basic $(echo -n "${GRAFANA_CLOUD_INSTANCE_ID}:${GRAFANA_CLOUD_API_KEY}" | base64)"
# 上記の出力をそのまま貼り付ける ("Basic base64_encoded_string" の形)
GRAFANA_CLOUD_BASIC_AUTH_HEADER=Basic replace-me

# resource attribute に乗せるホスト名 (任意)
HOSTNAME=otel-collector-docker
